---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineView from '../components/TimelineView';
import Disclaimer from '../components/Disclaimer.astro';
import { timelineSortKey, type Category, type LegalStatus } from '../lib/labels';

const cases = await getCollection('cases');

const events = cases.flatMap((c) => {
  // Curated per-case order is chronological; clamp padded keys so a
  // month-only event never sorts before the day-precise event it follows.
  let prevKey = '';
  return (c.data.timeline ?? []).map((e, i) => {
    const key = timelineSortKey(e.date);
    prevKey = prevKey > key ? prevKey : key;
    return {
      id: `${c.id}-${i}-${e.date}`,
      date: e.date,
      sortKey: prevKey,
      title: e.title,
      body: e.body,
      caseSlug: c.id,
      caseTitle: c.data.title,
      legalStatus: c.data.legal_status as LegalStatus,
      categories: c.data.categories as Category[],
    };
  });
});
---

<BaseLayout
  title="Timeline"
  description="Chronological view of events across curated Bitcoin crime case files."
>
  <div class="container-page pt-10 sm:pt-14 pb-16">
    <header class="mb-8 max-w-2xl">
      <h1 class="text-3xl sm:text-4xl mb-3">Timeline</h1>
      <p class="text-ink-muted leading-relaxed">
        Events drawn from published case files. Each entry links back to its
        full case and sources.
      </p>
    </header>
    <div class="mb-8">
      <Disclaimer compact />
    </div>
    <TimelineView client:load events={events} />
  </div>
</BaseLayout>
