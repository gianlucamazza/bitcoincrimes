---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import Disclaimer from '../components/Disclaimer.astro';
import {
  BRAND,
  legalStatusLabels,
  legalStatusHelp,
  timelineSortKey,
  type Category,
  type LegalStatus,
  type CaseStatus,
} from '../lib/labels';
import { withBase } from '../lib/site';

const allCases = await getCollection('cases');
const featured = allCases
  .filter((c) => c.data.featured)
  .sort((a, b) => {
    const reviewed = b.data.last_reviewed.localeCompare(a.data.last_reviewed);
    if (reviewed !== 0) return reviewed;
    return b.data.start_date.localeCompare(a.data.start_date);
  });
const show = featured.length > 0 ? featured : allCases.slice(0, 3);

/** Sparse milestone strip: one event per selected year from case timelines. */
const milestoneYears = [
  '2011',
  '2013',
  '2014',
  '2016',
  '2017',
  '2022',
  '2024',
  '2026',
];
const timelineEvents = allCases.flatMap((c) => {
  // Same monotonic clamp as timeline.astro: curated order is chronological.
  let prevKey = '';
  return (c.data.timeline ?? []).map((e) => {
    const key = timelineSortKey(e.date);
    prevKey = prevKey > key ? prevKey : key;
    return {
      date: e.date,
      title: e.title,
      slug: c.id,
      caseTitle: c.data.title,
      sortKey: prevKey,
    };
  });
});
const teaserMilestones = milestoneYears
  .map((y) => {
    const hit = timelineEvents
      .filter((e) => e.date.startsWith(y))
      .sort((a, b) => a.sortKey.localeCompare(b.sortKey))[0];
    return hit ? { year: y, ...hit } : null;
  })
  .filter((m): m is NonNullable<typeof m> => m !== null);

const guideStatuses: LegalStatus[] = [
  'charged',
  'convicted',
  'unresolved',
];
---

<BaseLayout
  title={BRAND.name}
  description={`${BRAND.tagline} ${BRAND.promise} Independent public-record archive.`}
>
  <section class="container-page pt-12 sm:pt-16 pb-10">
    <p class="text-xs uppercase tracking-[0.25em] text-accent mb-4">
      {BRAND.descriptor}
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] max-w-3xl leading-[1.12] mb-5">
      {BRAND.tagline}
    </h1>
    <p class="text-lg sm:text-xl text-ink-muted max-w-2xl leading-relaxed mb-3">
      Case files on dark markets, exchange thefts, ransomware, laundering, and
      sourced vendor-security incidents — built from public court, agency, and
      vendor records. We label legal status. We date every dollar figure. We do
      not publish unsourced guilt.
    </p>
    {
      allCases.length > 0 && (
        <p class="text-sm text-ink-faint mb-8">
          {allCases.length} case files in the archive · {BRAND.promise}
        </p>
      )
    }
    <div class="flex flex-wrap gap-3">
      <a
        href={withBase('/cases/')}
        class="no-underline inline-flex items-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-accent-fg hover:brightness-110"
      >
        Browse cases
      </a>
      <a
        href={withBase('/methodology/')}
        class="no-underline inline-flex items-center rounded-lg border border-line px-4 py-2.5 text-sm text-ink hover:border-accent/50 hover:text-accent"
      >
        How we source claims
      </a>
    </div>
  </section>

  <section class="container-page pb-6">
    <Disclaimer />
  </section>

  <section class="container-page py-10" aria-labelledby="featured-heading">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <h2 id="featured-heading" class="text-2xl sm:text-3xl">
          Start here
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Curated starters. Recently reviewed files first.
        </p>
      </div>
      <a href={withBase('/cases/')} class="text-sm text-accent no-underline hover:underline shrink-0">
        All cases →
      </a>
    </div>
    {
      show.length === 0 ? (
        <p class="text-ink-muted card p-6">No cases published yet.</p>
      ) : (
        <div class="grid gap-4 sm:gap-5">
          {show.map((c) => (
            <CaseCard
              slug={c.id}
              title={c.data.title}
              summary={c.data.summary}
              legalStatus={c.data.legal_status as LegalStatus}
              caseStatus={c.data.case_status as CaseStatus}
              categories={c.data.categories as Category[]}
              startDate={c.data.start_date}
              endDate={c.data.end_date}
              lastReviewed={c.data.last_reviewed}
            />
          ))}
        </div>
      )
    }
  </section>

  <section class="container-page py-10" aria-labelledby="guide-heading">
    <h2 id="guide-heading" class="text-2xl sm:text-3xl mb-2">
      How to read a case file
    </h2>
    <p class="text-ink-muted text-sm mb-6 max-w-2xl">
      Every file uses the same labels. The three most common are explained
      below; the full list is in the methodology.
    </p>
    <div class="grid gap-4 sm:grid-cols-3 mb-8">
      {
        guideStatuses.map((s) => (
          <div class="card p-4">
            <p class="badge border-line text-ink mb-2">{legalStatusLabels[s]}</p>
            <p class="text-sm text-ink-muted leading-relaxed">
              {legalStatusHelp[s]}
            </p>
          </div>
        ))
      }
    </div>
    <ol class="card p-5 sm:p-6 space-y-3 text-sm text-ink-muted list-decimal list-inside">
      <li>
        <strong class="text-ink">Key figures</strong> — BTC first; any USD has an
        as-of date and a source link.
      </li>
      <li>
        <strong class="text-ink">Timeline</strong> — public milestones, not
        speculation.
      </li>
      <li>
        <strong class="text-ink">Context</strong> — why the case matters for Bitcoin
        history.
      </li>
      <li>
        <strong class="text-ink">Sources</strong> — primary records first; open
        them before repeating a number.
      </li>
    </ol>
  </section>

  {
    teaserMilestones.length > 0 && (
      <section class="container-page py-10" aria-labelledby="era-heading">
        <div class="flex items-end justify-between gap-4 mb-6">
          <div>
            <h2 id="era-heading" class="text-2xl sm:text-3xl">
              Across the archive
            </h2>
            <p class="text-sm text-ink-muted mt-1">
              Selected milestones from published case timelines.
            </p>
          </div>
          <a
            href={withBase('/timeline/')}
            class="text-sm text-accent no-underline hover:underline shrink-0"
          >
            Full timeline →
          </a>
        </div>
        <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {teaserMilestones.map((m) => (
            <li class="card p-4 relative transition-colors hover:border-line-strong group">
              <p class="font-mono text-xs text-accent tabular-nums">{m.year}</p>
              <p class="font-serif text-base text-ink mt-1 leading-snug group-hover:text-accent transition-colors">
                {m.title}
              </p>
              <a
                href={withBase(`/cases/${m.slug}/`)}
                class="text-xs text-ink-muted no-underline mt-2 inline-block before:absolute before:inset-0 before:content-['']"
              >
                {m.caseTitle}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="container-page py-12 sm:py-16">
    <div class="card p-6 sm:p-8 grid gap-6 sm:grid-cols-3">
      <div>
        <h3 class="text-lg mb-2">Primary sources first</h3>
        <p class="text-sm text-ink-muted leading-relaxed">
          Court filings and agency releases over secondary news. If a figure is
          not in a public record we cite, it does not appear here.
        </p>
      </div>
      <div>
        <h3 class="text-lg mb-2">Status, not spin</h3>
        <p class="text-sm text-ink-muted leading-relaxed">
          Alleged, charged, convicted, acquitted — always visible. We do not
          imply guilt beyond the public record.
        </p>
      </div>
      <div>
        <h3 class="text-lg mb-2">Dated money</h3>
        <p class="text-sm text-ink-muted leading-relaxed">
          Bitcoin amounts preferred. Dollar values always carry a date, because
          price changes make naked “billions” misleading.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
