---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../lib/labels';
import { withBase } from '../lib/site';

// Alphabetized at render time; keep entries in any order below.
const terms = [
  {
    term: 'Dark market / darknet market',
    def: 'An online marketplace, often on Tor or similar networks, that lists illicit goods or services. Bitcoin has been used as a payment rail on several historically significant markets.',
    example: { href: withBase('/cases/silk-road/'), label: 'Silk Road' },
  },
  {
    term: 'Seizure',
    def: 'Law enforcement taking custody of property (including cryptocurrency) under legal authority, often via a warrant. A seizure is not by itself a conviction.',
    example: {
      href: withBase('/cases/colonial-pipeline/'),
      label: 'Colonial Pipeline',
    },
  },
  {
    term: 'Forfeiture',
    def: 'A legal process by which ownership of seized property may be transferred to the government. Criminal and civil forfeiture follow different procedures.',
    example: { href: withBase('/cases/helix/'), label: 'Helix' },
  },
  {
    term: 'Indictment',
    def: 'A formal charging instrument issued by a grand jury (in U.S. federal practice). Being indicted means formally charged, not convicted.',
    example: {
      href: withBase('/cases/mt-gox-2011-theft/'),
      label: 'Mt. Gox theft charges',
    },
  },
  {
    term: 'Money laundering',
    def: 'Conduct intended to conceal the origin, ownership, or control of proceeds of unlawful activity. Cryptocurrency tracing is often used in investigations of alleged laundering.',
    example: { href: withBase('/cases/bitfinex-2016/'), label: 'Bitfinex 2016' },
  },
  {
    term: 'Mixer / tumbler',
    def: 'A service that pools and redistributes cryptocurrency in an attempt to obscure transaction history. Legal status of operating or using mixers depends on jurisdiction and facts; this site only documents cases with public records.',
    example: { href: withBase('/cases/bitcoin-fog/'), label: 'Bitcoin Fog' },
  },
  {
    term: 'MSB (money services business)',
    def: 'A U.S. regulatory category that can include transmitters of money or value. Operating an unlicensed MSB is a charge that appears in several crypto enforcement cases.',
    example: { href: withBase('/cases/btc-e-vinnik/'), label: 'BTC-e' },
  },
  {
    term: 'Ransomware',
    def: 'Malware that encrypts or locks systems and demands payment (often in cryptocurrency) for restoration. Payments may later be traced and, in some cases, partially recovered.',
    example: {
      href: withBase('/cases/colonial-pipeline/'),
      label: 'Colonial Pipeline',
    },
  },
  {
    term: 'Exchange theft / hack',
    def: 'Unauthorized removal of customer or platform assets from a cryptocurrency exchange. Attribution and criminal charges are separate from the technical loss event.',
    example: { href: withBase('/cases/bitfinex-2016/'), label: 'Bitfinex 2016' },
  },
  {
    term: 'Hardware-wallet seed / entropy',
    def: 'The random input used to create a BIP-39 recovery seed that controls a wallet. If that entropy is weaker than intended, private keys can sometimes be reconstructed offline without touching the device. A firmware update does not repair a seed that was already generated on a weak path.',
    example: {
      href: withBase('/cases/coldcard-rng-2026/'),
      label: 'Coldcard RNG 2026',
    },
  },
  {
    term: 'Peg-in / peg-out',
    def: 'Moving bitcoin from the Bitcoin mainchain into a sidechain (peg-in, minting a representative unit such as L-BTC) or back out (peg-out, burning that unit to release locked BTC). A valid peg-out authorization is not by itself proof that the burned units were ever backed one-for-one.',
    example: {
      href: withBase('/cases/liquid-peg-out-2026/'),
      label: 'Liquid 2026 peg-out',
    },
  },
  {
    term: 'Confidential transactions / range proof',
    def: 'A construction that hides amounts (and sometimes asset types) behind cryptographic commitments. A range proof shows a hidden amount is non-negative without revealing it. Nodes may cache a successful check; a cache key that omits verification context, or that concatenates variable-length fields without framing, can accept a statement that full verification would reject.',
    example: {
      href: withBase('/cases/liquid-peg-out-2026/'),
      label: 'Liquid 2026 peg-out',
    },
  },
  {
    term: 'Federation (sidechain)',
    def: 'A designated set of functionaries who sign sidechain blocks and spend bitcoin locked in a peg wallet. Federation control is a different security model from Bitcoin proof-of-work consensus.',
    example: {
      href: withBase('/cases/liquid-peg-out-2026/'),
      label: 'Liquid 2026 peg-out',
    },
  },
  {
    term: 'Continuing criminal enterprise (CCE)',
    def: 'A U.S. federal offense sometimes charged against organizers of large-scale drug trafficking enterprises. Appears in major dark-market cases (e.g. Silk Road counts).',
    example: { href: withBase('/cases/silk-road/'), label: 'Silk Road' },
  },
  {
    term: 'Pardon / clemency',
    def: 'Executive relief that may remit a sentence. A full pardon does not mean “never convicted”; this archive keeps the conviction label and documents clemency as a separate timeline event when primary sources exist.',
    example: {
      href: withBase('/cases/silk-road/'),
      label: 'Silk Road (Ulbricht)',
    },
  },
  {
    term: 'Primary source',
    def: 'On this site: court documents, competent agency releases, or blockchain facts tightly framed by such authorities. Preferred over secondary news for hard claims.',
  },
  {
    term: 'As-of date (USD)',
    def: 'The date associated with a dollar valuation of a BTC amount. Required here whenever USD is shown, because price changes make undated dollar claims misleading.',
  },
];

terms.sort((a, b) => a.term.localeCompare(b.term, 'en'));
---

<BaseLayout
  title="Glossary"
  description={`Definitions used in ${BRAND.name} case files: seizure, forfeiture, mixer, dark market, and more.`}
>
  <div class="container-narrow pt-10 sm:pt-14 pb-16">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl mb-3">Glossary</h1>
      <p class="text-ink-muted leading-relaxed">
        Working definitions for terms used in case files. Not legal advice.
      </p>
    </header>
    <dl class="space-y-6">
      {
        terms.map((t) => (
          <div class="card p-5">
            <dt class="font-serif text-xl text-ink mb-2">{t.term}</dt>
            <dd class="text-sm sm:text-base text-ink-muted leading-relaxed">
              {t.def}
              {t.example && (
                <p class="mt-2 text-xs">
                  <span class="text-ink-faint">Example: </span>
                  <a
                    href={t.example.href}
                    class="text-accent no-underline hover:underline"
                  >
                    {t.example.label}
                  </a>
                </p>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>
