---
import BaseLayout from '../layouts/BaseLayout.astro';

const terms = [
  {
    term: 'Dark market / darknet market',
    def: 'An online marketplace, often on Tor or similar networks, that lists illicit goods or services. Bitcoin has been used as a payment rail on several historically significant markets.',
  },
  {
    term: 'Seizure',
    def: 'Law enforcement taking custody of property (including cryptocurrency) under legal authority, often via a warrant. A seizure is not by itself a conviction.',
  },
  {
    term: 'Forfeiture',
    def: 'A legal process by which ownership of seized property may be transferred to the government. Criminal and civil forfeiture follow different procedures.',
  },
  {
    term: 'Indictment',
    def: 'A formal charging instrument issued by a grand jury (in U.S. federal practice). Being indicted means formally charged, not convicted.',
  },
  {
    term: 'Money laundering',
    def: 'Conduct intended to conceal the origin, ownership, or control of proceeds of unlawful activity. Cryptocurrency tracing is often used in investigations of alleged laundering.',
  },
  {
    term: 'Mixer / tumbler',
    def: 'A service that pools and redistributes cryptocurrency in an attempt to obscure transaction history. Legal status of operating or using mixers depends on jurisdiction and facts; this site only documents cases with public records.',
  },
  {
    term: 'Ransomware',
    def: 'Malware that encrypts or locks systems and demands payment (often in cryptocurrency) for restoration. Payments may later be traced and, in some cases, partially recovered.',
  },
  {
    term: 'Exchange theft / hack',
    def: 'Unauthorized removal of customer or platform assets from a cryptocurrency exchange. Attribution and criminal charges are separate from the technical loss event.',
  },
  {
    term: 'Primary source',
    def: 'On this site: court documents, competent agency releases, or blockchain facts tightly framed by such authorities. Preferred over secondary news for hard claims.',
  },
  {
    term: 'As-of date (USD)',
    def: 'The date associated with a dollar valuation of a BTC amount. Required here whenever USD is shown, because price changes make undated dollar claims misleading.',
  },
];
---

<BaseLayout
  title="Glossary"
  description="Definitions of terms used in Bitcoin crime case files: seizure, forfeiture, mixer, dark market, and more."
>
  <div class="container-narrow pt-10 sm:pt-14 pb-16">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl mb-3">Glossary</h1>
      <p class="text-ink-muted leading-relaxed">
        Working definitions for terms used in case files. Not legal advice.
      </p>
    </header>
    <dl class="space-y-6">
      {
        terms.map((t) => (
          <div class="card p-5">
            <dt class="font-serif text-xl text-ink mb-2">{t.term}</dt>
            <dd class="text-sm sm:text-base text-ink-muted leading-relaxed">
              {t.def}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>
