---
import { BRAND } from '../lib/labels';
import { withBase, REPO_URL, REPO_ISSUES_URL } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line mt-20">
  <div class="container-page py-10 sm:py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <p class="font-serif text-lg text-ink mb-1">{BRAND.name}</p>
        <p class="text-[10px] uppercase tracking-[0.18em] text-ink-faint mb-3">
          {BRAND.descriptor}
        </p>
        <p class="text-sm text-ink-muted leading-relaxed max-w-sm">
          {BRAND.tagline}
          {' '}
          Independent. Not legal advice. Not affiliated with any agency.
        </p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-ink-faint mb-3">Navigate</p>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/cases/')} class="text-ink-muted no-underline hover:text-accent">Cases</a></li>
          <li><a href={withBase('/timeline/')} class="text-ink-muted no-underline hover:text-accent">Timeline</a></li>
          <li><a href={withBase('/search/')} class="text-ink-muted no-underline hover:text-accent">Search</a></li>
          <li><a href={withBase('/glossary/')} class="text-ink-muted no-underline hover:text-accent">Glossary</a></li>
          <li><a href={withBase('/methodology/')} class="text-ink-muted no-underline hover:text-accent">Methodology</a></li>
          <li><a href={withBase('/about/')} class="text-ink-muted no-underline hover:text-accent">About</a></li>
          <li><a href={withBase('/rss.xml')} class="text-ink-muted no-underline hover:text-accent">RSS</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wider text-ink-faint mb-3">Trust</p>
        <ul class="space-y-2 text-sm text-ink-muted">
          <li>{BRAND.promise}</li>
          <li>U.S. court and agency records dominate current coverage</li>
          <li>
            <a href={withBase('/methodology/')} class="text-accent no-underline hover:underline">
              How we source claims →
            </a>
          </li>
          <li>
            <a href={withBase('/about/#corrections')} class="text-accent no-underline hover:underline">
              Corrections →
            </a>
          </li>
          <li>
            <a href={REPO_ISSUES_URL} class="text-accent no-underline hover:underline" rel="noopener noreferrer">
              Report an error
            </a>
            {' · '}
            <a href={REPO_URL} class="text-accent no-underline hover:underline" rel="noopener noreferrer">
              Source
            </a>
          </li>
        </ul>
      </div>
    </div>
    <p class="mt-10 pt-6 border-t border-line text-xs text-ink-faint">
      © {year} {BRAND.name}. Independent public-record archive. No affiliation with
      any law-enforcement agency.
    </p>
  </div>
</footer>
