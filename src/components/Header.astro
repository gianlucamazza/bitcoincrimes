---
import { BRAND } from '../lib/labels';
import { withBase } from '../lib/site';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const links = [
  { href: withBase('/cases/'), label: 'Cases' },
  { href: withBase('/timeline/'), label: 'Timeline' },
  { href: withBase('/search/'), label: 'Search' },
  { href: withBase('/methodology/'), label: 'Methodology' },
  { href: withBase('/about/'), label: 'About' },
];

function isActive(href: string) {
  const normalized = href.endsWith('/') ? href.slice(0, -1) : href;
  const current = path.endsWith('/') && path !== base ? path.slice(0, -1) : path;
  if (href === base || href === withBase('/')) {
    return path === base || path === `${base}`.replace(/\/?$/, '/') || path === '/';
  }
  return current === normalized || current.startsWith(`${normalized}/`);
}
---

<header class="border-b border-line/80 bg-paper/80 backdrop-blur-md sticky top-0 z-40">
  <div class="container-page flex items-center justify-between gap-4 h-14 sm:h-16">
    <a href={withBase('/')} class="no-underline flex items-baseline gap-2 shrink-0 group">
      <span class="font-serif text-lg sm:text-xl text-ink group-hover:text-accent transition-colors">
        {BRAND.name}
      </span>
      <span class="hidden md:inline text-[10px] uppercase tracking-[0.18em] text-ink-faint">
        {BRAND.descriptor}
      </span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-0.5 sm:gap-1 overflow-x-auto">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'no-underline text-xs sm:text-sm px-2 sm:px-3 py-1.5 rounded-md whitespace-nowrap transition-colors',
              isActive(href)
                ? 'text-accent bg-accent-soft'
                : 'text-ink-muted hover:text-ink hover:bg-paper-raised',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
