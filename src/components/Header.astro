---
const path = Astro.url.pathname;

const links = [
  { href: '/cases', label: 'Cases' },
  { href: '/timeline', label: 'Timeline' },
  { href: '/search', label: 'Search' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/about', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="border-b border-line/80 bg-paper/80 backdrop-blur-md sticky top-0 z-40">
  <div class="container-page flex items-center justify-between gap-4 h-14 sm:h-16">
    <a href="/" class="no-underline flex items-baseline gap-2 shrink-0 group">
      <span class="font-serif text-lg sm:text-xl text-ink group-hover:text-accent transition-colors">
        Bitcoin Crimes
      </span>
      <span class="hidden sm:inline text-[10px] uppercase tracking-[0.2em] text-ink-faint">
        Archive
      </span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2 overflow-x-auto">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'no-underline text-xs sm:text-sm px-2 sm:px-3 py-1.5 rounded-md whitespace-nowrap transition-colors',
              isActive(href)
                ? 'text-accent bg-accent-soft'
                : 'text-ink-muted hover:text-ink hover:bg-paper-raised',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
