---
import StatusBadge from './StatusBadge.astro';
import CategoryBadge from './CategoryBadge.astro';
import { formatLooseDate, type Category, type LegalStatus, type CaseStatus } from '../lib/labels';

interface Props {
  slug: string;
  title: string;
  summary: string;
  legalStatus: LegalStatus;
  caseStatus: CaseStatus;
  categories: Category[];
  startDate: string;
  endDate?: string;
  lastReviewed: string;
}

const {
  slug,
  title,
  summary,
  legalStatus,
  caseStatus,
  categories,
  startDate,
  endDate,
  lastReviewed,
} = Astro.props;

const range = endDate
  ? `${formatLooseDate(startDate)} – ${formatLooseDate(endDate)}`
  : `${formatLooseDate(startDate)} –`;
---

<article class="card group transition-colors hover:border-line-strong">
  <a href={`/cases/${slug}`} class="block p-5 sm:p-6 no-underline text-inherit">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
      <StatusBadge legalStatus={legalStatus} caseStatus={caseStatus} size="sm" />
      <time class="text-xs text-ink-faint font-mono tabular-nums" datetime={startDate}>
        {range}
      </time>
    </div>
    <h2 class="text-xl sm:text-2xl group-hover:text-accent transition-colors mb-2">
      {title}
    </h2>
    <p class="text-sm sm:text-base text-ink-muted leading-relaxed line-clamp-3">
      {summary}
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      {categories.map((c) => <CategoryBadge category={c} />)}
    </div>
    <p class="mt-4 text-xs text-ink-faint">
      Last reviewed {formatLooseDate(lastReviewed)}
    </p>
  </a>
</article>
