---
import { absoluteUrl } from '../lib/site';

interface Props {
  title: string;
  slug: string;
  lastReviewed: string;
}

const { title, slug, lastReviewed } = Astro.props;
const url = absoluteUrl(`/cases/${slug}/`);
const cite = `“${title}.” Bitcoin Crimes Public Record Archive. Last reviewed ${lastReviewed}. ${url}`;
---

<section aria-labelledby="how-to-cite">
  <h2 id="how-to-cite" class="text-2xl mb-4">How to cite</h2>
  <div class="card p-4 sm:p-5">
  <p class="text-sm text-ink-muted mb-3">
    Suggested citation (verify figures against the linked primary sources):
  </p>
  <blockquote
    class="font-mono text-xs sm:text-sm text-ink/90 leading-relaxed border-l-2 border-accent/40 pl-3"
  >
    {cite}
  </blockquote>
  </div>
</section>
