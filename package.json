{
  "name": "bitcoincrimes",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Curated, source-backed archive of high-profile Bitcoin-primary criminal cases.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "validate:related": "node scripts/validate-related.mjs",
    "test:schema": "tsx scripts/assert-schema-rejects.ts",
    "test:base-hrefs": "node scripts/assert-base-hrefs.mjs",
    "verify": "pnpm validate:related && pnpm test:schema && pnpm check && pnpm build && pnpm test:base-hrefs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "pagefind": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
