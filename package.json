{
  "name": "bitcoincrimes",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Curated, source-backed archive of high-profile Bitcoin-primary criminal cases.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "validate:related": "node scripts/validate-related.mjs",
    "test:schema": "tsx scripts/assert-schema-rejects.ts",
    "verify": "pnpm validate:related && pnpm test:schema && pnpm check && pnpm build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
